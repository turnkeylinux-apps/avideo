#!/bin/bash -ex

APP=avideo

WEBROOT=/var/www/$APP
ENCROOT=$WEBROOT-encoder
SRC=/usr/local/src

AVIDEO_REF=29.0
AVIDEO_COMMIT=2386f39caea1d2ef36267b252fa76af283294623
ENCODER_REF=8.0
ENCODER_COMMIT=71759ba94928bd324b6171b53b1d3e9e43760b91

WEB_USER='admin'
MAIL=$WEB_USER@example.com
PASS=turnkey

DB_NAME=$APP
DB_NAME_ENC=${APP}_encoder
DB_USER=avideo
DB_PASS=$PASS

USER=www-data

# modify php configuration for AVideo requirements
for php_ini in /etc/php/*/apache2/php.ini; do
    test -f "$php_ini"
    sed -i "s|^memory_limit.*|memory_limit = 512M|" "$php_ini"
    sed -i "s|^upload_max_filesize.*|upload_max_filesize = 1000M|" "$php_ini"
    sed -i "s|^post_max_size.*|post_max_size = 1000M|" "$php_ini"
    sed -i "s|^allow_url_fopen.*|allow_url_fopen = On|" "$php_ini"
    sed -i "s|^max_execution.*|max_execution_time = 21600|" "$php_ini"
done

# configure Apache for AVideo
a2dissite 000-default
a2ensite avideo
a2ensite avideo-encoder
a2enmod expires
a2enmod headers
a2enmod rewrite
a2enmod xsendfile

# Install the official release tags and fail if either tag moves.
GH_URL=https://github.com/WWBN
git clone --depth=1 --branch "$AVIDEO_REF" $GH_URL/AVideo.git $WEBROOT
git clone --depth=1 --branch "$ENCODER_REF" $GH_URL/AVideo-Encoder.git $ENCROOT
test "$(git -C "$WEBROOT" rev-parse HEAD)" = "$AVIDEO_COMMIT"
test "$(git -C "$ENCROOT" rev-parse HEAD)" = "$ENCODER_COMMIT"
git -C "$WEBROOT" fsck --strict
git -C "$ENCROOT" fsck --strict
mkdir -p {$WEBROOT,$ENCROOT}/videos

# Encoder 8.0 still invokes the historical executable name.
ln -s /usr/bin/yt-dlp /usr/local/bin/youtube-dl

# ensure correct permissions set on web directories
chown -R $USER:$USER $WEBROOT $ENCROOT

service mysql start
service apache2 start

# Create Databases grant permissions
for db in $DB_NAME $DB_NAME_ENC; do
    mysqladmin --user=root create "$db"
done
mysql --user=root --batch \
    -e "CREATE USER '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS';"
for db in $DB_NAME $DB_NAME_ENC; do
    mysql --user=root --batch \
        -e "GRANT ALL ON $db.* TO '$DB_USER'@'localhost';"
done

# Install both applications through their CLI-only configuration entry point.
php $SRC/turnkey-avideo-install.php streamer \
    "$WEBROOT" https://www.example.com/ "$DB_NAME" "$DB_USER" \
    "$DB_PASS" "$PASS" "$MAIL"
php $SRC/turnkey-avideo-install.php encoder \
    "$ENCROOT" https://www.example.com/encoder/ "$DB_NAME_ENC" "$DB_USER" \
    "$DB_PASS" "$PASS" "$MAIL" https://www.example.com/

# Seed one upstream media asset as a deterministic playback fixture.
php $SRC/turnkey-avideo-fixture.php
chown -R $USER:$USER $WEBROOT/videos

rm $SRC/turnkey-avideo-install.php $SRC/turnkey-avideo-fixture.php

service mysql stop
service apache2 stop

mv $SRC/nginx.conf /etc/nginx/nginx.conf
rm /etc/nginx/sites-enabled/default

# Create Directories necessary for live stream
mkdir -p /HLS/{live,low}
chown -R $USER:$USER /HLS

apache2ctl -t
